            "index": 11,
            "characterId": "779d6973-0d9e-4e35-907e-61399def5193",
            "useContentId": true,
            "contentId": "ch1_4029",
            "content": {
                "en": "That’s exactly what I was waiting for!",
                "zh": "不错，就等着你这句呢！",
                "ja": ""
            },
            "positionX": 2249.0,
            "positionY": -679.0,
            "choices": [],
            "eventCalls": [],
