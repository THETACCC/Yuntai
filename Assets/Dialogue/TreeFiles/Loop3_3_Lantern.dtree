{
    "nodes": [
        {
            "id": "1a0cbf7e-1efd-45cc-8ae1-e1d1a7c2164a",
            "index": 0,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_4021",
            "content": {
                "en": "Hello, I noticed there seems to be quite a pile of lanterns beside your stall?",
                "zh": "您好，我看到摊位旁边似乎堆着不少花灯？",
                "ja": ""
            },
            "positionX": -70.0,
            "positionY": -326.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "fd04a56a-68f6-41f2-bb8a-fc4430dd30e3",
            "index": 1,
            "characterId": "779d6973-0d9e-4e35-907e-61399def5193",
            "useContentId": true,
            "contentId": "ch1_3105",
            "content": {
                "en": "Ah! Really? That’s such perfect timing!",
                "zh": "啊！可以吗！这可真是太及时了！",
                "ja": ""
            },
            "positionX": 987.0,
            "positionY": -2035.0,
            "choices": [
                {
                    "useTextId": true,
                    "textId": "ch1_3106",
                    "text": {
                        "en": "My pleasure. Where do they need to be hung?",
                        "zh": "没事的，请问需要挂到哪里呢？",
                        "ja": ""
                    },
                    "conditions": [],
                    "conditionLogic": 0
                }
            ],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "ab42b28b-a63a-48b4-9621-9bd9ebeb9108",
            "index": 2,
            "characterId": "779d6973-0d9e-4e35-907e-61399def5193",
            "useContentId": true,
            "contentId": "ch1_3107",
            "content": {
                "en": "Ah! There’s a <color=orange>diagram</color> here. Just follow it and <color=orange>hang them under the eaves over on the left</color>.",
                "zh": "啊！这里有张<color=orange>示意图</color>，照着这个去<color=orange>左边那里的屋檐处挂上</color>就好。",
                "ja": ""
            },
