            "useContentId": true,
            "contentId": "ch1_10007",
            "content": {
                "en": "Ma’am! Would you like something to eat?",
                "zh": "女士，请问您要用餐吗？",
                "ja": ""
            },
            "positionX": 2917.0,
            "positionY": 719.0,
