      "name": {
        "en": "Veris",
        "zh": "何以真",
        "ja": ""
      },
      "avatarAddr": "DialogueImages/何以真_日常",
      "isPlayer": true,
      "content": {
        "en": "No, ma’am. My friend invited me to visit. I didn’t even know the festival was happening.",
        "zh": "是的阿姨，我是受朋友邀请而来的，事先都不知道有乞巧大会的事。",
        "ja": ""
      },
