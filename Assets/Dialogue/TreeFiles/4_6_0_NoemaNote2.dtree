            "characterId": "8bf512c1-230a-4da9-a433-47d205ee6363",
            "useContentId": true,
            "contentId": "ch2_4060",
            "content": {
                "en": "...Sometimes, even I can’t tell.",
                "zh": "……有时候连我自己都分不清。”",
