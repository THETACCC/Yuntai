            "index": 11,
            "characterId": "8bf512c1-230a-4da9-a433-47d205ee6363",
            "useContentId": true,
            "contentId": "ch2_4058",
            "content": {
                "en": "Is this really what I want?",
                "zh": "还是说，",
                "ja": ""
            },
            "positionX": 2620.0,
            "positionY": 373.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": [],
            "textAlignment": 0
        },
        {
            "id": "f73b65d3-2c29-4342-9ee7-cbb7339923f2",
            "index": 12,
            "characterId": "8bf512c1-230a-4da9-a433-47d205ee6363",
            "useContentId": true,
            "contentId": "ch2_4059",
            "content": {
                "en": "Or is it just that, I’ve already come this far, so I can’t turn back anymore?",
                "zh": "我只是已经走到这里，所以不能回头了？",
                "ja": ""
            },
            "positionX": 2978.0,
            "positionY": 372.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": [],
            "textAlignment": 0
