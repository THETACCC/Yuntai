            "index": 8,
            "characterId": "e3614b9a-4789-4305-ac57-4a6bac607584",
            "useContentId": true,
            "contentId": "ch2_1040",
            "content": {
                "en": "I was going to take you around first, then go get it from home, but I might not be able to leave right now.",
                "zh": "本来想带你转完会场回家去取的，现在可能走不开了。",
                "ja": ""
            },
            "positionX": 1449.333251953125,
            "positionY": 113.33332824707031,
            "choices": [],
            "eventCalls": [],
