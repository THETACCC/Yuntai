            "characterId": "e3614b9a-4789-4305-ac57-4a6bac607584",
            "useContentId": true,
            "contentId": "ch2_1045",
            "content": {
                "en": "Hah… (sigh)",
                "zh": "哈啊......（叹气）",
                "ja": ""
            },
            "positionX": 3125.33349609375,
            "positionY": 128.6666717529297,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "223a4a10-0f26-40bd-a073-7d9beb575ab0",
            "index": 5,
            "characterId": "c5690423-74d1-4bca-8967-89da828b1a25",
            "useContentId": true,
            "contentId": "ch2_1046",
            "content": {
                "en": "It’s fine, you handle it. I’ll head over now. Thanks in advance for the gift.",
                "zh": "没事，你忙，我这就过去。提前谢谢你的礼物了。",
                "ja": ""
            },
            "positionX": 3454.666748046875,
            "positionY": 134.6666717529297,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "0dddecb9-cce6-4b0e-83a6-b8cc050686de",
            "index": 6,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch2_1038",
            "content": {
                "en": "It’s okay. I can look around on my own—go take care of your work.",
                "zh": "没关系，我自己去转就好，你先忙。",
                "ja": ""
            },
            "positionX": 773.3333740234375,
            "positionY": 104.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
