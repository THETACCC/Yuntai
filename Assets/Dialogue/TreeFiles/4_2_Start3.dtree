            "index": 7,
            "characterId": "7324b771-f6f5-4d90-b605-0ae0697e44d9",
            "useContentId": true,
            "contentId": "ch2_1039",
            "content": {
                "en": "Sorry… Oh, right. I have a gift for you.",
                "zh": "抱歉......对了，我有个礼物要给你。",
                "ja": ""
            },
            "positionX": 1109.333251953125,
            "positionY": 109.33332824707031,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
