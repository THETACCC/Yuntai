            "useContentId": true,
            "contentId": "ch2_4094",
            "content": {
                "en": "",
                "zh": "那个......我之前在公寓楼里，遇见了奇怪的东西。",
                "ja": ""
            },
            "positionX": 443.0,
            "positionY": 101.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "0b03d5c1-5f14-4993-9f03-b67aea57b3ba",
            "index": 2,
            "characterId": "3d251560-306a-4584-8903-bebe74011bfc",
            "useContentId": true,
            "contentId": "ch2_4095",
            "content": {
                "en": "",
                "zh": "您知道是怎么回事吗？",
                "ja": ""
            },
            "positionX": 790.0,
            "positionY": 105.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
