        },
        {
            "id": "882142d7-6e7f-49e7-96f4-8301d8d21621",
            "index": 15,
            "characterId": "ec21035f-a4fe-4bb6-b877-eb871a5ec2cf",
            "useContentId": true,
            "contentId": "ch2_3036",
            "content": {
                "en": "Looks like I’ve said too much…",
                "zh": "看来是老头子我多话了......",
                "ja": ""
            },
            "positionX": 5512.0,
            "positionY": 334.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "c15cb73a-0ad0-4295-b019-0650a5c25588",
            "index": 16,
            "characterId": "ec21035f-a4fe-4bb6-b877-eb871a5ec2cf",
            "useContentId": true,
            "contentId": "ch2_3037",
            "content": {
                "en": "Go on now—<color=orange>Douqiao</color> has already started.",
                "zh": "快去吧，斗巧已经开始了。",
                "ja": ""
            },
            "positionX": 5845.0,
            "positionY": 336.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "3b8f6052-dfea-43f7-9028-45c90f760210",
            "index": 17,
            "characterId": "d5be2dcf-87aa-4ebc-afce-674209069707",
            "useContentId": true,
            "contentId": "ch2_3038",
            "content": {
                "en": "(I need to hurry to the stage and find Noema!)",
                "zh": "（我得赶紧去戏台找梦之！）",
                "ja": ""
            },
            "positionX": 6189.0,
            "positionY": 341.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
