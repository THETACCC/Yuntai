            "index": 15,
            "characterId": "ec21035f-a4fe-4bb6-b877-eb871a5ec2cf",
            "useContentId": true,
            "contentId": "ch2_3036",
            "content": {
                "en": "Looks like I’ve said too much…",
                "zh": "看来是老头子我多话了......",
                "ja": ""
            },
            "positionX": 5304.66650390625,
            "positionY": 161.3333282470703,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
