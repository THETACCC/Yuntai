            "contentId": "ch2_4093",
            "content": {
                "en": "",
                "zh": "哟，小姑娘，又见面啦？",
                "ja": ""
            },
            "positionX": 100.0,
            "positionY": 100.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
