            "index": 16,
            "characterId": "ec21035f-a4fe-4bb6-b877-eb871a5ec2cf",
            "useContentId": true,
            "contentId": "ch2_3037",
            "content": {
                "en": "Go on now—the performance is about to begin.",
                "zh": "快去吧，表演要开始了。",
                "ja": ""
            },
            "positionX": 5638.0,
            "positionY": 162.6666717529297,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
