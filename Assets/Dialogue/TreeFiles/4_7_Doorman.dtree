            "characterId": "ec21035f-a4fe-4bb6-b877-eb871a5ec2cf",
            "useContentId": true,
            "contentId": "ch2_3031",
            "content": {
                "en": "Oh! You’re going to find Little Shen—aren’t you?",
                "zh": "噢！你要去找小沈对吧？",
                "ja": ""
            },
            "positionX": 3760.0,
            "positionY": 322.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
