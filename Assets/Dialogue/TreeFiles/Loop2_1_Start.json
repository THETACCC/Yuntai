    {
      "index": 7,
      "name": {
        "en": "Veris",
        "zh": "何以真",
        "ja": ""
      },
      "avatarAddr": "DialogueImages/何以真_闭眼",
      "isPlayer": true,
      "content": {
        "en": "That's strange. My old notebook was already full, and this one is the brand-new one I bought before coming to Yuntai. So why is there writing in it?",
        "zh": "奇怪？之前的笔记本写满了，这个明明是我来芸台前新买的，为什么会有字？",
        "ja": ""
      },
      "nextIndex": 6
