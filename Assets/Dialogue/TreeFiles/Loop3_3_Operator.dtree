{
    "nodes": [
        {
            "id": "f3af1f14-a919-4481-a206-c3c27d7d0ee2",
            "index": 0,
            "characterId": "175d32ab-deb4-4be5-8f1d-b4b4c2e0fa60",
            "useContentId": true,
            "contentId": "ch1_4049",
            "content": {
                "en": "Hey, young lady, come give us a hand.",
                "zh": "哎小姑娘，过来搭把手！",
                "ja": ""
            },
            "positionX": 110.0,
            "positionY": 708.0,
            "choices": [
                {
                    "useTextId": true,
                    "textId": "ch1_4050",
                    "text": {
                        "en": "Um... okay.",
                        "zh": "嗯...好",
                        "ja": ""
                    },
                    "conditions": [],
                    "conditionLogic": 0
                },
                {
                    "useTextId": true,
                    "textId": "ch1_4051",
                    "text": {
                        "en": "(Pretend to ignore them.)",
                        "zh": "（假装无视）",
                        "ja": ""
                    },
                    "conditions": [],
                    "conditionLogic": 0
                }
            ],
            "eventCalls": [
                {
                    "targetObjectID": "f3c78097-f6b9-4192-82c6-457003e8c026",
