            "useContentId": true,
            "contentId": "ch1_3122",
            "content": {
                "en": "Sorry to bother you.",
                "zh": "不好意思打扰你一下。",
                "ja": ""
            },
            "positionX": 522.0,
            "positionY": 122.0,
            "choices": [],
            "eventCalls": [],
