            "characterId": "7dce9553-65bb-400b-9970-de7217fdd43d",
            "useContentId": true,
            "contentId": "ch1_2100",
            "content": {
                "en": "The in-flight meal still smells tempting, but there’s a faint, indescribable odor of decay mixed in.",
                "zh": "飞机餐依旧散发着诱人的香气，却隐约夹杂着一丝难以言喻的腐臭味。",
                "ja": ""
            },
            "positionX": -2198.0,
            "positionY": 778.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
