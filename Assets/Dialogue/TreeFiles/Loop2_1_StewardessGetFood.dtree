            "useContentId": true,
            "contentId": "ch1_2096",
            "content": {
                "en": "Um, excuse me?",
                "zh": "那个，乘务员小姐？",
                "ja": ""
            },
            "positionX": -3638.0,
            "positionY": 778.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
