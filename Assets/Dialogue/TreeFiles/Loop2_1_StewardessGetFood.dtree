            "characterId": "fe717acf-a852-4395-beb4-8cbc7dc92d14",
            "useContentId": true,
            "contentId": "ch1_2142",
            "content": {
                "en": "Yeah, yeah, just go already...",
                "zh": "行了行了快走吧......",
                "ja": ""
