            "index": 40,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_2143",
            "content": {
                "en": "(Even though she saw through me, I guess the strategy still worked.)",
