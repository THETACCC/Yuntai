            "index": 1,
            "characterId": "fe717acf-a852-4395-beb4-8cbc7dc92d14",
            "useContentId": true,
            "contentId": "ch1_2097",
            "content": {
                "en": "Hm? What else, miss?",
                "zh": "嗯？又有什么事吗女士？",
                "ja": ""
            },
            "positionX": -3282.0,
            "positionY": 778.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
