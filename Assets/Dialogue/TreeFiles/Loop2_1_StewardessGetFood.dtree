        {
            "id": "9ef15120-cecc-4c8c-a65c-19aee6d15b81",
            "index": 2,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_2098",
            "content": {
                "en": "There’s a girl back there who looks really hungry. Would it be possible for me to take a meal to her?",
                "zh": "后面有一个女生似乎饿得很厉害，请问我可以先从这里拿一盒飞机餐给她吗？",
                "ja": ""
            },
            "positionX": -2922.0,
            "positionY": 778.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "3fe03181-a422-4610-bd36-dc1429ee9849",
            "index": 3,
            "characterId": "8e0b2383-21fb-426e-bb74-fdbc40a2b884",
            "useContentId": true,
            "contentId": "ch1_2099",
            "content": {
                "en": "Of course. Go ahead and take one.",
                "zh": "当然可以，随便拿吧。",
                "ja": ""
            },
            "positionX": -2556.0,
            "positionY": 778.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "98f02357-4b8f-4d1d-bb9f-67c60b469bf4",
