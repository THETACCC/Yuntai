            "characterId": "3d251560-306a-4584-8903-bebe74011bfc",
            "useContentId": true,
            "contentId": "ch1_2189",
            "content": {
                "en": "Is there anything I can do to help?",
                "zh": "有什么我能帮忙的地方吗？",
