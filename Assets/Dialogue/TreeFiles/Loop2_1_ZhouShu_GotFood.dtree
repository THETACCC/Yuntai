            "useContentId": true,
            "contentId": "ch1_2187",
            "content": {
                "en": "What?",
                "zh": "什么？",
                "ja": ""
            },
            "positionX": 1602.39990234375,
            "positionY": 272.79998779296877,
            "choices": [],
