            "characterId": "481038d5-cf0b-4d90-b374-cf1fd0c406cd",
            "useContentId": true,
            "contentId": "ch1_2188",
            "content": {
                "en": "Something seriously troublesome has found its way onto this plane... This meal is absolutely not food anyone should eat!",
                "zh": "这架飞机上恐怕混进了很麻烦的家伙...... 这飞机餐，绝对不是什么能吃的食物！",
                "ja": ""
            },
            "positionX": 1955.199951171875,
            "positionY": 272.79998779296877,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
