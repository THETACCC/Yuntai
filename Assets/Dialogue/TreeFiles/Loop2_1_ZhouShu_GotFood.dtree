            "useContentId": true,
            "contentId": "ch1_2186",
            "content": {
                "en": "Alright, Veris. Listen to me carefully. Go hide in the <color=orange>restroom at the back</color>, now!",
                "zh": "好的，何以真，你听我说，现在立刻去到<color=orange>后面的卫生间</color>躲起来！",
                "ja": ""
            },
            "positionX": 1255.199951171875,
