        "en": "Veris",
        "zh": "何以真",
        "ja": ""
      },
      "avatarAddr": "DialogueImages/何以真_日常",
      "isPlayer": true,
      "content": {
        "en": "I learned a few things over the first two loops. Isn’t this somewhere near the Yuntai Festival grounds?",
