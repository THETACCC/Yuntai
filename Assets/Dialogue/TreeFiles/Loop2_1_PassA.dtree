            "id": "71013a6b-1785-4c5a-ac34-32742c7ec746",
            "index": 22,
            "characterId": "d5be2dcf-87aa-4ebc-afce-674209069707",
            "useContentId": true,
            "contentId": "ch1_2048",
            "content": {
                "en": "(Noema... never thought she’d come this far.)",
                "zh": "（沈梦之...没想到现在已经如此出人头地了啊。）",
                "ja": ""
            },
