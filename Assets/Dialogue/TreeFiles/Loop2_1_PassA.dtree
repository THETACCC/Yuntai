{
    "nodes": [
        {
            "id": "bcc7dab2-cd71-447a-b620-6da54d672ec7",
            "index": 1,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_2024",
            "content": {
                "en": "(They seem to be locals returning from a trip. I could use this chance to ask them about the area.)",
                "zh": "（他们似乎是旅游回来的本地居民，对芸台市的近况较为了解。 我可以趁机打听一些当地的事。）",
                "ja": ""
            },
            "positionX": 4105.3330078125,
            "positionY": 356.6666564941406,
            "choices": [
                {
                    "useTextId": true,
                    "textId": "ch1_2025",
                    "text": {
                        "en": "About this \"<color=orange>Troupe Elysium</color>\"...",
                        "zh": "关于这个“<color=orange>极乐戏团</color>”...",
                        "ja": ""
                    },
                    "conditions": [
                        {
                            "targetObjectID": "",
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "infoPassA_1",
                            "comparison": 0,
                            "compareValue": "False"
                        }
                    ],
                    "conditionLogic": 0
                },
                {
                    "useTextId": true,
                    "textId": "ch1_2026",
                    "text": {
                        "en": "What does the <color=orange>festival</color> refer to?",
                        "zh": "您提到的<color=orange>大会</color>是指？",
                        "ja": ""
                    },
                    "conditions": [
                        {
                            "targetObjectID": "",
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "infoPassA_2",
                            "comparison": 0,
                            "compareValue": "False"
                        }
                    ],
                    "conditionLogic": 0
                },
                {
                    "useTextId": true,
                    "textId": "ch1_2027",
                    "text": {
                        "en": "Thank you for telling me all this.",
                        "zh": "非常感谢您告诉我这些事。（结束对话）",
                        "ja": ""
                    },
                    "conditions": [
                        {
                            "targetObjectID": "",
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "infoPassA_1",
                            "comparison": 0,
                            "compareValue": "True"
                        },
                        {
                            "targetObjectID": "",
                            "targetObjectName": "LevelManager2_1",
