        {
            "id": "9897c0a9-3125-4905-a90f-680ae0c03e51",
            "index": 23,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_2059",
            "content": {
                "en": "No, no. I just left here for college, so I’ve fallen a bit out of touch with what’s been going on lately.",
                "zh": "不是不是，我只是大学离开了这里，对近况有些脱节了。",
                "ja": ""
            },
            "positionX": 4920.0,
            "positionY": 1296.6666259765625,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "b73e8965-0d73-4282-be53-d49d8195c098",
            "index": 24,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "useContentId": true,
            "contentId": "ch1_2060",
            "content": {
                "en": "Oh, then you picked the perfect time to come back. Lucky you!",
                "zh": "哎呀，这样正好赶上才叫幸运呢！回来玩的开心哦！",
                "ja": ""
            },
