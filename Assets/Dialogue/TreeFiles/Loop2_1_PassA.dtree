        {
            "id": "d7b8d099-0365-49d4-9c94-be6796c03037",
            "index": 25,
            "characterId": "3d251560-306a-4584-8903-bebe74011bfc",
            "useContentId": true,
            "contentId": "ch1_2061",
            "content": {
                "en": "Huh?",
                "zh": "欸？",
                "ja": ""
            },
            "positionX": 5954.66650390625,
            "positionY": 1296.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "087aa2a6-2844-41a5-aca8-f1483c82c166",
            "index": 26,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "useContentId": true,
            "contentId": "ch1_2063",
            "content": {
                "en": "You didn’t know? Then be extra careful over the next few days.",
                "zh": "没有吗，那这几天一定要注意安全哦。",
                "ja": ""
            },
            "positionX": 6316.66650390625,
            "positionY": 1296.6666259765625,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "fc57413e-7bc8-4007-aa76-5b3ca6ed9740",
            "index": 27,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_2065",
            "content": {
                "en": "Thank you. I will.",
                "zh": "谢谢您，我会小心的。",
                "ja": ""
            },
            "positionX": 6705.3330078125,
            "positionY": 1300.6666259765625,
            "choices": [],
            "eventCalls": [
                {
                    "targetObjectID": "02651c1e-be9d-46c9-9cc1-b817e9aeef45",
