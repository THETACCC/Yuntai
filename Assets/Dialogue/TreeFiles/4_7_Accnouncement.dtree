            "index": 7,
            "characterId": "",
            "useContentId": true,
            "contentId": "ch2_3056",
            "content": {
                "en": "",
                "zh": "遵守规则，享受大会。金兰观全体人员，祝愿您在芸台大会期间游玩愉快。",
                "ja": ""
