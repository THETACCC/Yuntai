            "characterId": "",
            "useContentId": true,
            "contentId": "ch2_3055",
            "content": {
                "en": "",
                "zh": "5.本条街道仅有约百米长，若您发现街道延申至极远方向，请......",
                "ja": ""
            },
            "positionX": 8779.2001953125,
            "positionY": 316.79998779296877,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
