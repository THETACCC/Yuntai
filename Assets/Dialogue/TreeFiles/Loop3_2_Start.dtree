            "index": 6,
            "characterId": "91eae646-d3d2-46e9-9336-e09e16836545",
            "useContentId": true,
            "contentId": "ch1_3034",
            "content": {
                "en": "I’m going back to the temple first to see if I can get help, but I can’t just leave those people there to die.",
                "zh": "我会先回道观看看能不能搬到救兵，但总归不能放着那些人等死。",
                "ja": ""
