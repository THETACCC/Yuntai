                    "conditions": [],
                    "conditionLogic": 0
                },
                {
                    "useTextId": true,
                    "textId": "ch1_3036",
                    "text": {
                        "en": "Then take care. I should get going.",
                        "zh": "那你保重，我先走了。",
                        "ja": ""
