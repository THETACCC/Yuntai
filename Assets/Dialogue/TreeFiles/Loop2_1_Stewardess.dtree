            "useContentId": true,
            "contentId": "ch1_2080",
            "content": {
                "en": "Oh no, miss. I'm afraid you’re not allowed to bother the passengers up front.",
                "zh": "哎呀女士，不可以去打扰前面的客人。",
                "ja": ""
            },
            "positionX": -1285.3333740234375,
            "positionY": 208.66665649414063,
            "choices": [],
