    "nodes": [
        {
            "id": "12ad5e88-c868-4a02-9da4-473a1ca990c4",
            "index": 0,
            "characterId": "3d251560-306a-4584-8903-bebe74011bfc",
            "useContentId": true,
            "contentId": "ch1_2084",
            "content": {
                "en": "(...She's so harsh.)",
                "zh": "（......她真的好刻薄。）",
                "ja": ""
            },
            "positionX": 328.0,
            "positionY": 208.8000030517578,
            "choices": [
                {
                    "useTextId": true,
                    "textId": "ch1_2085",
                    "text": {
                        "en": "Why are you standing here this whole time?",
                        "zh": "您为什么一直站在这里呢？",
                        "ja": ""
                    },
                    "conditions": [],
                    "conditionLogic": 0
                },
                {
                    "useTextId": true,
                    "textId": "ch1_2086",
                    "text": {
                        "en": "Sorry, I’ll be going now.",
                        "zh": "打扰您了，我这就走。",
                        "ja": ""
                    },
                    "conditions": [],
                    "conditionLogic": 0
                }
            ],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "18ee0b9e-c927-4fb0-8c3a-dd729a3f1b96",
            "index": 1,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_2087",
            "content": {
                "en": "You’ve been standing here for quite a while... may I ask...",
                "zh": "您似乎已经在这里站了好一阵了，请问——",
                "ja": ""
            },
            "positionX": 892.7999877929688,
            "positionY": 185.60000610351563,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "3414076d-054b-4eba-8da2-8f101816c69b",
            "index": 2,
            "characterId": "7dce9553-65bb-400b-9970-de7217fdd43d",
            "useContentId": true,
            "contentId": "ch1_2089",
            "content": {
                "en": "The stewardess shot Veris a vicious glare, then suddenly broke into a strange smile.",
                "zh": "乘务员狠狠地瞪了一眼何以真，却又露出了诡异的微笑！",
                "ja": ""
            },
            "positionX": 1628.7999267578125,
            "positionY": 196.8000030517578,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "edda421a-5ed9-4ed4-b4e4-a4f3ee267e26",
            "index": 3,
            "characterId": "3b78db21-bf34-49b0-b3ed-7ae7c9b63453",
            "useContentId": true,
            "contentId": "ch1_2090",
            "content": {
                "en": "Oh, I don’t know, ma’am. It’s just that our glorious <color=orange>chief attendant</color> suddenly ordered me to be here on standby. I’m not allowed to leave until she gets back to me.",
                "zh": "我也不知道呢这位女士。只是我们尊敬的<color=orange>乘务长</color>大人，忽然莫名奇妙的要求我站在这里待命，在她回复我之前绝对不能离开岗位而已呢。",
                "ja": ""
            },
            "positionX": 1998.39990234375,
            "positionY": 196.8000030517578,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "819260b1-cca1-4699-b83b-8e69462be5b9",
            "index": 4,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_2093",
            "content": {
                "en": "Sorry to bother you. I’ll be on my way.",
                "zh": "打扰您了，我这就离开。",
                "ja": ""
            },
            "positionX": 891.2000122070313,
            "positionY": 664.7999877929688,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
