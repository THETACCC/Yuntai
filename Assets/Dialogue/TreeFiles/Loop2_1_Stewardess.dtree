            "characterId": "3d251560-306a-4584-8903-bebe74011bfc",
            "useContentId": true,
            "contentId": "ch1_2082",
            "content": {
                "en": "(The stewardess' eyes couldn’t hide her spite, as if she were about to lash out at any second.)",
                "zh": "（乘务员的眼神藏不住她的刻薄，仿佛下一秒她就要破口大骂。）",
                "ja": ""
            },
            "positionX": -492.0,
            "positionY": 208.8000030517578,
            "choices": [],
            "eventCalls": [],
