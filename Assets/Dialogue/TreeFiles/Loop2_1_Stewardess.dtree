            "useContentId": true,
            "contentId": "ch1_2084",
            "content": {
                "en": "(...She's so harsh.)",
                "zh": "（......她真的好刻薄。）",
                "ja": ""
            },
            "positionX": 328.0,
            "positionY": 208.66665649414063,
            "choices": [
                {
                    "useTextId": true,
                    "textId": "ch1_2085",
                    "text": {
                        "en": "Why are you standing here this whole time?",
                        "zh": "您为什么一直站在这里呢？",
                        "ja": ""
                    },
                    "conditions": [],
                    "conditionLogic": 0
                },
                {
                    "useTextId": true,
                    "textId": "ch1_2086",
                    "text": {
                        "en": "Sorry, I’ll be going now.",
                        "zh": "打扰了，我这就走",
                        "ja": ""
                    },
                    "conditions": [],
                    "conditionLogic": 0
                }
            ],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
