        },
        {
            "id": "edda421a-5ed9-4ed4-b4e4-a4f3ee267e26",
            "index": 5,
            "characterId": "3b78db21-bf34-49b0-b3ed-7ae7c9b63453",
            "useContentId": true,
            "contentId": "ch1_2090",
            "content": {
                "en": "Oh, I don’t know, ma’am. It’s just that our glorious <color=orange>chief attendant</color> suddenly ordered me to be here on standby. I’m not allowed to leave until she gets back to me.",
                "zh": "我也不知道呢这位女士。只是我们尊敬的<color=orange>乘务长</color>大人，忽然莫名奇妙的要求我站在这里待命，在她回复我之前绝对不能离开岗位而已呢。",
                "ja": ""
            },
            "positionX": 1998.0,
            "positionY": 197.3333282470703,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "1ee4c100-4d10-4b2c-91b9-6a265b9dc6ea",
            "index": 6,
            "characterId": "ed1baf90-69f0-402f-959a-2683ad667ded",
            "useContentId": true,
            "contentId": "ch1_2091",
            "content": {
                "en": "(She’s speaking through clenched teeth...)",
                "zh": "（她在咬着牙说话......）",
                "ja": ""
            },
            "positionX": 2332.0,
            "positionY": 197.3333282470703,
            "choices": [],
