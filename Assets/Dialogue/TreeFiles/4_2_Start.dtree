            "index": 14,
            "characterId": "d5be2dcf-87aa-4ebc-afce-674209069707",
            "useContentId": true,
            "contentId": "ch2_1031a",
            "content": {
                "en": "(Looks like now’s not a good time to talk... Better find another chance later.)",
                "zh": "（看来现在是说不上了……之后再找机会吧。）",
