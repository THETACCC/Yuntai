            "characterId": "9bf1f67d-ba62-4b57-a9cc-3ce252972f0f",
            "useContentId": true,
            "contentId": "ch2_1029",
            "content": {
                "en": "(Noema…)",
                "zh": "（梦之......）",
                "ja": ""
