            "characterId": "7324b771-f6f5-4d90-b605-0ae0697e44d9",
            "useContentId": true,
            "contentId": "ch2_1030",
            "content": {
                "en": "Anyway—want me to show you around the festival grounds?",
                "zh": "不说了，我带你去转转会场吧？",
