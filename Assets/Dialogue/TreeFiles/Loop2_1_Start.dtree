            "characterId": "3d251560-306a-4584-8903-bebe74011bfc",
            "useContentId": true,
            "contentId": "ch1_2011b",
            "content": {
                "en": "(...Huh?)",
                "zh": "（……嗯？）",
                "ja": ""
            },
            "positionX": 4673.0,
            "positionY": 303.0,
            "choices": [],
            "eventCalls": [],
