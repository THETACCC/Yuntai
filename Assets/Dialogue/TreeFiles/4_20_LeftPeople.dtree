            "characterId": "",
            "useContentId": true,
            "contentId": "ch2_3147",
            "content": {
                "en": "Jinlan Temple ahead should be quieter now—you can go rest before the awards start.",
                "zh": "前面的金兰观这会儿应该比较清静，你可以趁着颁奖还没开始，过去休息一下。",
                "ja": ""
            },
            "positionX": 8931.2001953125,
            "positionY": 241.59999084472657,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
