{
    "nodes": [
        {
            "id": "e0839a13-df1b-4e5a-88b6-5cf5c5b30bf4",
            "index": 0,
            "characterId": "",
            "useContentId": true,
            "contentId": "ch2_3141",
            "content": {
                "en": "Sis! Mom, it’s her! The girl who did the drumming!",
                "zh": "姐姐！妈妈，是敲鼓的姐姐！",
                "ja": ""
            },
            "positionX": 7020.80029296875,
            "positionY": 241.59999084472657,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "671e345e-a141-4f00-848e-48af5d0413cf",
            "index": 1,
            "characterId": "",
            "useContentId": true,
            "contentId": "ch2_3142",
            "content": {
                "en": "Sis, you were amazing! The drum was so loud—I felt like I was going to be blown away!",
                "zh": "姐姐你好厉害呀！那个鼓的声音好大！我都要被震飞出去啦！",
                "ja": ""
            },
            "positionX": 7339.2001953125,
            "positionY": 241.59999084472657,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "52c2af6d-6723-414e-852c-163d0729b5a0",
            "index": 2,
            "characterId": "",
            "useContentId": true,
            "contentId": "ch2_3143",
            "content": {
                "en": "Sorry, my child’s a bit excited. You played wonderfully. Everyone was completely captivated.",
                "zh": "抱歉，这孩子有点激动。你鼓敲的真好，一曲下来，大家都听入迷了呢。",
                "ja": ""
            },
            "positionX": 7657.60009765625,
            "positionY": 241.59999084472657,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "1dba2a6c-bbce-4b7a-af36-dafd258ff647",
            "index": 3,
            "characterId": "",
            "useContentId": true,
            "contentId": "ch2_3144",
            "content": {
                "en": "Ah, thank you. I just did my best.",
                "zh": "啊，谢谢您。我只是尽力一试而已。",
                "ja": ""
            },
            "positionX": 7976.0,
            "positionY": 241.59999084472657,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "9f7f0467-9139-4fa5-afa1-47ce9e854402",
            "index": 4,
            "characterId": "",
            "useContentId": true,
            "contentId": "ch2_3145",
            "content": {
                "en": "So cool! When I grow up, I want to be like you!",
                "zh": "好帅！我长大以后也要像姐姐这样！",
                "ja": ""
            },
            "positionX": 8294.400390625,
            "positionY": 241.59999084472657,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "ae71da12-6b5b-400f-9038-89607b865c5f",
            "index": 5,
            "characterId": "",
            "useContentId": true,
            "contentId": "ch2_3146",
            "content": {
                "en": "Alright, don’t bother her. You must be exhausted too, right?",
                "zh": "好啦，不要吵姐姐了。你也累坏了吧？",
                "ja": ""
            },
            "positionX": 8612.7998046875,
            "positionY": 241.59999084472657,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
