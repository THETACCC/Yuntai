      "nextIndex": 18
    },
    {
      "index": 18,
      "name": {
        "en": "Puppet Vendor",
        "zh": "木偶摊主",
        "ja": ""
      },
      "avatarAddr": "DialogueImages/男孩父亲 1",
      "isPlayer": false,
      "content": {
        "en": "Hahaha, you’re very welcome! It’s been a long time since I met someone who likes puppets this much!",
        "zh": "哈哈哈哈哈不客气不客气！好久没遇到这么喜欢木偶的人了！",
        "ja": ""
      },
      "nextIndex": 19
    },
    {
      "index": 19,
      "name": {
        "en": "Puppet Vendor",
        "zh": "木偶摊主",
        "ja": ""
      },
      "avatarAddr": "DialogueImages/男孩父亲 1",
      "isPlayer": false,
      "content": {
        "en": "If you see me at the fair tomorrow, remember to come say hi. I’ll give you a discount!",
        "zh": "明天大会上见到，记得来打声招呼，我给你打折！",
        "ja": ""
      },
