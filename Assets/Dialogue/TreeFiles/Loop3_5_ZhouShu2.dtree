            "useContentId": true,
            "contentId": "ch1_3235",
            "content": {
                "en": "Oh, no worries! It’s not mine.",
                "zh": "哦哦！没事儿！这不是我的血。",
                "ja": ""
            },
            "positionX": 1403.199951171875,
            "positionY": 216.8000030517578,
