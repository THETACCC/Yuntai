            "useContentId": true,
            "contentId": "ch1_3236",
            "content": {
                "en": "... (Looks like she really is strong.)",
                "zh": "......（看来她确实挺强的。）",
                "ja": ""
            },
            "positionX": 1732.0,
            "positionY": 217.59999084472657,
