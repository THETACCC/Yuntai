      "index": 0,
      "name": {
        "en": "Veris",
        "zh": "何以真",
        "ja": ""
      },
      "avatarAddr": "DialogueImages/何以真_日常",
      "isPlayer": true,
      "content": {
        "en": "Hello, I noticed there seems to be quite a pile of lanterns beside your stall?",
        "zh": "您好，我看到摊位旁边似乎堆着不少花灯？",
        "ja": ""
      },
      "textAlignment": 0,
      "nextIndex": 3,
      "eventCalls": [
        {
          "targetObjectID": "f3c78097-f6b9-4192-82c6-457003e8c026",
          "targetObjectName": "LevelManager3_3",
          "componentTypeName": "LevelManager3_3",
