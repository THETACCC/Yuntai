          "stringParameter": "",
          "intParameter": 0,
          "floatParameter": 0,
          "boolParameter": false,
          "triggerTiming": 0
        }
      ]
    },
    {
      "index": 1,
      "name": {
        "en": "Lantern Vendor",
        "zh": "花灯摊主",
        "ja": ""
      },
      "avatarAddr": "DialogueImages/花灯摊主_日常",
      "isPlayer": false,
      "content": {
        "en": "Ah! Really? That would be a huge help!",
        "zh": "啊！可以吗！这可真是太及时了！",
        "ja": ""
      },
      "textAlignment": 0,
      "nextIndex": -1,
      "choices": [
        {
          "text": {
            "en": "It’s no trouble. Where should they be hung?",
            "zh": "没事的，请问需要挂到哪里呢？",
            "ja": ""
          },
          "targetIndex": 2
        }
      ]
    },
