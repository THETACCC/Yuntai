        {
            "id": "cf60cd7b-5cfe-4af3-be24-a3d4b19fef9b",
            "index": 1,
            "name": "Me",
            "avatarAssetPath": "Assets/Resources/DialogueImages/何以真_闭眼.png",
            "content": "Those visions......No, it's just a nightmare. Just a nightmare.",
            "positionX": 1118.39990234375,
            "positionY": 717.6000366210938,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "4e19d2e6-02a7-4e2e-91ad-9a28f7c73116",
            "index": 2,
            "name": "Me",
            "avatarAssetPath": "Assets/Resources/DialogueImages/何以真_闭眼.png",
            "content": "Noema, my best friend back in high school. I can't even remember the last time I dreamed about her.",
            "positionX": 1488.0,
            "positionY": 717.6000366210938,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "2aec9db7-74c2-4a06-808e-824baf9d7aed",
            "index": 4,
            "name": "Me",
            "avatarAssetPath": "Assets/Resources/DialogueImages/何以真_日常.png",
            "content": "Why would she suddenly invite me here...? Never mind. No use dwelling on it. I’ll ask her in person when we meet.",
            "positionX": 2185.599853515625,
            "positionY": 717.6000366210938,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "c012602e-2343-4a4d-af84-fdeff6b7f197",
            "index": 3,
            "name": "Me",
            "avatarAssetPath": "Assets/Resources/DialogueImages/何以真_日常.png",
            "content": "She promised we'd stay in touch after graduation. But once college started, she never texted me—not even once did she reply to my messages.",
            "positionX": 1837.5999755859375,
            "positionY": 717.6000366210938,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "05d51a34-4b57-43a6-9ba7-9d51621cd73f",
            "index": 5,
            "name": "Me",
            "avatarAssetPath": "Assets/Resources/DialogueImages/何以真_日常.png",
            "content": "I should get up, stretch a little, and head to the restroom.",
            "positionX": 2540.800048828125,
            "positionY": 717.6000366210938,
