    {
      "index": 6,
      "name": "Veris",
      "avatarAddr": "DialogueImages/何以真_日常",
      "content": "No need to thank me. I’m just glad you’re okay. I’m Veris, from Wenqiu City.",
      "nextIndex": 11,
      "choices": [],
      "eventCalls": []
    },
    {
      "index": 7,
      "name": "Page",
      "avatarAddr": "DialogueImages/周书_日常",
      "content": "Huh? Oh—an in-flight meal! Really? Thank you so much!",
      "nextIndex": 8,
      "choices": [],
      "eventCalls": []
    },
    {
      "index": 8,
      "name": "Page",
      "avatarAddr": "DialogueImages/周书_闭眼",
      "content": "Whew~ I’m alive again! I was in such a rush to catch the flight that I didn’t have time to eat. By the time I realized, I was already too hungry to think straight.",
      "nextIndex": 9,
      "choices": [],
      "eventCalls": []
    },
    {
      "index": 9,
      "name": "Page",
      "avatarAddr": "DialogueImages/周书_日常",
      "content": "Ah! I’m so sorry! I was so focused on eating that I completely ignored you! ",
      "nextIndex": 10,
      "choices": [],
      "eventCalls": []
    },
    {
      "index": 10,
      "name": "Page",
      "avatarAddr": "DialogueImages/周书_日常",
      "content": "I’m Page from Jinlan Temple in Yuntai. Thank you so much for saving me! May I ask your name?",
      "nextIndex": 6,
      "choices": [],
      "eventCalls": []
    },
    {
      "index": 11,
      "name": "Veris",
      "avatarAddr": "DialogueImages/何以真_日常",
      "content": "(She looks much better now. I should be able to ask her a few questions.)",
      "nextIndex": -1,
      "choices": [
        {
          "text": "What is this Jinlan Temple you mentioned?",
          "targetIndex": 12,
          "conditions": [
            {
              "targetObjectName": "LevelManager2_1",
              "componentTypeName": "LevelManager2_1",
              "variableName": "isZhouShu_Conv5",
              "comparison": "Equal",
              "compareValue": "False"
            }
          ],
          "conditionLogic": "AND"
        },
        {
          "text": "That’s a very unique outfit...",
          "targetIndex": 22,
          "conditions": [
            {
              "targetObjectName": "LevelManager2_1",
              "componentTypeName": "LevelManager2_1",
              "variableName": "isZhouShu_Conv6",
