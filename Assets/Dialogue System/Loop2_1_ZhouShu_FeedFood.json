    },
    {
      "index": 34,
      "name": "",
      "avatarAddr": "",
      "content": "(I should probably tell her what I saw in the dream, even if just as a precaution.)",
      "nextIndex": 35,
      "choices": [],
      "eventCalls": []
    },
    {
      "index": 35,
      "name": "",
      "avatarAddr": "",
      "content": "It might sound crazy, but earlier I think I saw some strange... people in the front cabin.",
      "nextIndex": 36,
      "choices": [],
