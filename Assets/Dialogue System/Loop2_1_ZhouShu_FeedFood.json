    {
      "index": 15,
      "name": {
        "en": "Page",
        "zh": "周书",
        "ja": ""
      },
      "avatarAddr": "DialogueImages/周书_日常",
      "content": {
        "en": "Not really. We’re probably the most prominent sect in the city. Jinlan Temple has apparently been around since Yuntai was first established, so it’s got quite a bit of history.",
        "zh": "那倒不是，我们应该算是市里独大的道派。而且金兰观好像在芸台建市之初就已经存在了，算是很有历史的道观了。",
        "ja": ""
      },
      "nextIndex": 16,
      "choices": [],
      "eventCalls": []
    },
