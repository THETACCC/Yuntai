            "index": 2,
            "characterId": "779d6973-0d9e-4e35-907e-61399def5193",
            "useContentId": true,
            "contentId": "ch1_3107",
            "content": {
                "en": "Ah! There’s a diagram here. Just follow it and hang them under the eaves over on the left.",
                "zh": "啊！这里有张示意图，照着这个去左边那里的屋檐处挂上就好。",
                "ja": ""
            },
            "positionX": 3636.0,
            "positionY": 19.333335876464845,
