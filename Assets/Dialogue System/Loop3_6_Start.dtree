            "contentId": "ch1_3241",
            "content": {
                "en": "",
                "zh": "呼！闹腾了一遭终于解决了！真是多亏了你帮忙啊！",
                "ja": ""
            },
            "positionX": 170.39999389648438,
            "positionY": 148.0,
            "choices": [],
