            "index": 14,
            "characterId": "",
            "useContentId": true,
            "contentId": "ch1_3255",
            "content": {
                "en": "",
                "zh": "嘿嘿！这镜子叫做明镜，可是师父专门派我去纹秋取回来的，它其实是这届芸台大会斗巧环节的最终奖品！",
                "ja": ""
            },
            "positionX": 4644.80029296875,
            "positionY": 157.60000610351563,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
