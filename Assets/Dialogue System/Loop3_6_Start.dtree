            "index": 15,
            "characterId": "",
            "useContentId": true,
            "contentId": "ch1_3256",
            "content": {
                "en": "",
                "zh": "不过不是任意移动啦，它的影响范围只限于芸台市区，具体原因我也不太清楚就是了。",
                "ja": ""
            },
            "positionX": 4963.2001953125,
            "positionY": 159.1999969482422,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
