            "index": 16,
            "characterId": "",
            "useContentId": true,
            "contentId": "ch1_3257",
            "content": {
                "en": "",
                "zh": "这样啊，那你师父后来居然肯让你拿它过来解决飞机上的事......",
                "ja": ""
