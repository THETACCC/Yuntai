            "index": 3,
            "characterId": "",
            "useContentId": true,
            "contentId": "ch1_3244",
            "content": {
                "en": "",
                "zh": "我都还不知道你名字啊！",
                "ja": ""
            },
            "positionX": 1125.5999755859375,
            "positionY": 148.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
