            "index": 11,
            "characterId": "9bf1f67d-ba62-4b57-a9cc-3ce252972f0f",
            "useContentId": true,
            "contentId": "ch1_3132",
            "content": {
                "en": "(What exactly is that drumbeat for?)",
                "zh": "（这鼓声究竟是做什么用的呢？）",
                "ja": ""
            },
