            "index": 10,
            "characterId": "9bf1f67d-ba62-4b57-a9cc-3ce252972f0f",
            "useContentId": true,
            "contentId": "ch1_3131",
            "content": {
                "en": "(Back on the plane, the PA system seemed to be playing some sort of drumbeat too.)",
                "zh": "（之前在飞机上的时候，飞机上的广播系统似乎也在播放某种鼓声。）",
                "ja": ""
            },
            "positionX": 3497.599853515625,
            "positionY": 123.19999694824219,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
