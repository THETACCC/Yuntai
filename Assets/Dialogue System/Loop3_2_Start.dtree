            "characterId": "9bf1f67d-ba62-4b57-a9cc-3ce252972f0f",
            "useContentId": true,
            "contentId": "ch1_3050",
            "content": {
                "en": "(Uh… but isn’t your name Page?)",
                "zh": "（呃，但你的名字不是叫周书吗？）",
