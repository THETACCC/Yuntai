            "characterId": "1a519e99-26bd-4cf6-a1eb-a6e92ba8abe5",
            "useContentId": true,
            "contentId": "ch1_3049",
            "content": {
                "en": "Oh my god, you’re amazing! I’m terrible at anything that needs brainpower!",
                "zh": "天呐！你真是太好了！我最不擅长需要动脑子的事情了！",
