            "index": 15,
            "characterId": "9bf1f67d-ba62-4b57-a9cc-3ce252972f0f",
            "contentId": "Loop3_2_Start_node_15_dialogue",
            "content": {
                "en": "Wait, maybe I can help.",
                "zh": "等等，或许我能帮上你的忙。",
                "ja": ""
            },
            "positionX": 3421.33349609375,
            "positionY": 1198.0,
            "choices": [],
