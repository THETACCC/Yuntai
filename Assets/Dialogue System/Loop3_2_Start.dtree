            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_3038",
            "content": {
                "en": "Then you really need to be careful. Don’t end up badly injured again like before.",
                "zh": "那你多多保重，千万别像之前一样重伤了。",
