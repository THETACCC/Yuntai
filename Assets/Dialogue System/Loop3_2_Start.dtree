            "characterId": "91eae646-d3d2-46e9-9336-e09e16836545",
            "contentId": "Loop3_2_Start_node_26_dialogue",
            "content": {
                "en": "I’ll head back to the temple for now—should we regroup here later?",
                "zh": "我先回一趟道观，待会咱们还在这儿集合？",
                "ja": ""
            },
            "positionX": 7153.3330078125,
