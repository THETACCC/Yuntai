            "contentId": "Loop2_1_Stewardess_node_1_dialogue",
            "content": {
                "en": "(...She's so harsh.)",
                "zh": "（......她真的好刻薄。）",
                "ja": ""
            },
            "positionX": 328.0,
            "positionY": 209.59999084472657,
            "choices": [
                {
                    "textId": "Loop2_1_Stewardess_node_1_choice_0",
                    "text": {
                        "en": "Why are you standing here this whole time?",
                        "zh": "您为什么一直站在这里呢？",
                        "ja": ""
                    },
                    "conditions": [],
                    "conditionLogic": 0
                },
                {
                    "textId": "Loop2_1_Stewardess_node_1_choice_1",
                    "text": {
                        "en": "Sorry, I’ll be going now. ",
                        "zh": "打扰了，我这就走",
