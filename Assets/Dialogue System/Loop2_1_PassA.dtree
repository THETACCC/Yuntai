            "index": 33,
            "characterId": "318c68cb-5927-41a5-91bd-bf8aa614ee91",
            "useContentId": true,
            "contentId": "ch1_2048",
            "content": {
                "en": "If that were the case, I’m sure the authorities would’ve stepped in by now.",
                "zh": "不过要真是这样，官方机关肯定会介入的。",
                "ja": ""
            },
            "positionX": 7786.66650390625,
            "positionY": 21.333335876464845,
