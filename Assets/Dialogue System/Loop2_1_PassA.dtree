        },
        {
            "id": "9897c0a9-3125-4905-a90f-680ae0c03e51",
            "index": 34,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "content": {
                "en": "No, ma’am. I’m here on a friend’s invitation. I didn’t even know the festival was happening.",
                "zh": "",
                "ja": ""
            },
            "positionX": 4933.3330078125,
            "positionY": 1112.6666259765625,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "8c52c5bd-4fa7-4d19-b6c2-154985fbc15d",
            "index": 2,
            "characterId": "0d2edd26-5554-47f2-b61f-99a5a0caf64b",
            "content": {
                "en": "Dad! Look! This arm can bend all the way back! So cool!",
                "zh": "",
                "ja": ""
            },
            "positionX": -160.0,
            "positionY": 365.3333435058594,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "0eec9ba1-b565-4e17-819d-949bd8480165",
            "index": 3,
            "characterId": "03fbd1fc-0e37-4fb2-abea-a8bb2982cffb",
            "content": {
                "en": "(That’s exactly what he said in the dream… and that puppet in his hand—it reminds me of what he turned into.)",
                "zh": "",
                "ja": ""
            },
            "positionX": 227.33334350585938,
            "positionY": 365.3333435058594,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
