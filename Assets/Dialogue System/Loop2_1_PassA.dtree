                    "boolParameter": false,
                    "parameterType": 0,
                    "triggerOnEnd": false
                }
            ],
            "conditionalBranches": []
        },
        {
            "id": "0df8024f-669c-4680-ba93-aa00b27a9f01",
            "index": 17,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "content": {
                "en": "Oh dear, kids your age really do love mysterious groups like that, huh~",
                "zh": "",
                "ja": ""
            },
            "positionX": 4906.0,
            "positionY": 392.6666564941406,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "ea70856c-866b-4cf5-8a56-f568728b5e65",
            "index": 23,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "content": {
                "en": "They looked super suspicious. If their flyers hadn’t said they were performing at this year’s Qiqiao Festival, I’d honestly have thought they were some weird cult sneaking into the city.",
                "zh": "",
                "ja": ""
            },
            "positionX": 7440.0,
            "positionY": 392.6666564941406,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "71013a6b-1785-4c5a-ac34-32742c7ec746",
            "index": 33,
            "characterId": "318c68cb-5927-41a5-91bd-bf8aa614ee91",
            "content": {
                "en": "If that were the case, I’m sure the authorities would’ve stepped in by now.",
                "zh": "",
                "ja": ""
            },
            "positionX": 7834.66650390625,
            "positionY": 284.6666564941406,
            "choices": [],
            "eventCalls": [
                {
                    "targetObjectName": "NoteBook",
                    "componentTypeName": "NoteBookManager",
                    "methodName": "UnlockEvent1",
                    "stringParameter": "",
                    "intParameter": 0,
