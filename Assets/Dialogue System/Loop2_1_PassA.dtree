        {
            "id": "9897c0a9-3125-4905-a90f-680ae0c03e51",
            "index": 34,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_2059",
            "content": {
                "en": "No, ma’am. I’m here on a friend’s invitation. I didn’t even know the festival was happening.",
                "zh": "是的阿姨，我是受朋友邀请而来的，事先都不知道有乞巧大会的事。",
                "ja": ""
            },
            "positionX": 4933.3330078125,
            "positionY": 1112.6666259765625,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "b73e8965-0d73-4282-be53-d49d8195c098",
            "index": 35,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "useContentId": true,
            "contentId": "ch1_2060",
            "content": {
                "en": "Oh, then you’re in luck! It’s the perfect time to visit. Hope you have a great time here!",
                "zh": "哎呀，这样正好赶上才叫幸运呢！在芸台玩的开心哦！",
                "ja": ""
            },
            "positionX": 5302.0,
            "positionY": 1112.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "d7b8d099-0365-49d4-9c94-be6796c03037",
            "index": 36,
            "characterId": "3d251560-306a-4584-8903-bebe74011bfc",
            "useContentId": true,
            "contentId": "ch1_2062",
            "content": {
                "en": "What?",
                "zh": "欸？",
                "ja": ""
            },
            "positionX": 5968.0,
            "positionY": 1112.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "087aa2a6-2844-41a5-aca8-f1483c82c166",
            "index": 37,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "useContentId": true,
            "contentId": "ch1_2063",
            "content": {
                "en": "They didn’t? Then make sure you stay close to your friend, okay?",
                "zh": "没有吗，那记得平常都跟朋友呆在一起。",
                "ja": ""
            },
            "positionX": 6330.0,
            "positionY": 1112.6666259765625,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "fc57413e-7bc8-4007-aa76-5b3ca6ed9740",
            "index": 38,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_2065",
            "content": {
                "en": "Thank you—I will.",
                "zh": "谢谢您，我会小心的。",
                "ja": ""
            },
            "positionX": 7102.66650390625,
            "positionY": 1120.6666259765625,
            "choices": [],
            "eventCalls": [
                {
                    "targetObjectID": "09e0c5c3-0cc9-471a-8688-7c565f40fd26",
                    "targetObjectName": "NoteBook",
                    "targetSceneName": "",
                    "componentTypeName": "NoteBookManager",
                    "methodName": "UnlockEventFeedBack",
                    "stringParameter": "",
