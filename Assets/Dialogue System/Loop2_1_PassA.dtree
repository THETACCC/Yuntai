                    "floatParameter": 0.0,
                    "boolParameter": false,
                    "parameterType": 0,
                    "triggerTiming": 1
                },
                {
                    "targetObjectID": "1175873a-279b-436d-9780-9ead830025e7",
                    "targetObjectName": "EventTab",
                    "targetSceneName": "",
                    "componentTypeName": "TabManager",
                    "methodName": "RefreshUnlockedTabs",
                    "stringParameter": "",
                    "intParameter": 0,
                    "floatParameter": 0.0,
                    "boolParameter": false,
                    "parameterType": 0,
                    "triggerTiming": 1
                },
                {
                    "targetObjectID": "c1748a8b-1624-492b-8fe0-557d862455ea",
                    "targetObjectName": "Event4_CityLock",
                    "targetSceneName": "",
                    "componentTypeName": "isThisUnlocked",
                    "methodName": "UnlockThis",
                    "stringParameter": "",
                    "intParameter": 0,
                    "floatParameter": 0.0,
                    "boolParameter": false,
                    "parameterType": 0,
                    "triggerTiming": 1
                }
            ],
            "conditionalBranches": []
        },
        {
            "id": "a11f855e-87e6-4c47-badf-3bcfd8ba12cf",
            "index": 40,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "useContentId": true,
            "contentId": "ch1_2066",
            "content": {
                "en": "Yeah, maybe starting about half a month ago, there were folks showing up in Yuntai calling themselves the “Troupe Elysium.”",
                "zh": "从大概半个月前开始吧，芸台市里开始出现一些自称为“极乐戏团”成员的人",
                "ja": ""
            },
            "positionX": 2702.0,
            "positionY": 360.6666564941406,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "1d0d0961-82d0-4e36-b01f-3fa69aba6fa0",
            "index": 41,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "useContentId": true,
            "contentId": "ch1_2067",
            "content": {
                "en": "They said they were performing at this year’s festival, and started promoting themselves all over the city.",
                "zh": "他们好像是要参与今年的大会进行表演吧，一直在市区各种地方进行宣传。",
                "ja": ""
            },
            "positionX": 3028.666748046875,
            "positionY": 362.6666564941406,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "cbd7a84b-da17-458d-902b-405ab958e7c4",
            "index": 42,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "useContentId": true,
            "contentId": "ch1_2068",
            "content": {
                "en": "One day after school, we ran into them handing out free merch on the street. He really liked one of the puppets.",
                "zh": "我带这孩子放学回家的时候，正好碰上他们在路边发放免费的周边，这孩子特别喜欢其中的木偶。",
                "ja": ""
            },
            "positionX": 3396.0,
            "positionY": 360.6666564941406,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "7c8aee80-238b-4016-917b-54ab5390b1cd",
            "index": 43,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "useContentId": true,
            "contentId": "ch1_2046",
            "content": {
                "en": "I’ve seen them around, handing out merch and giving talks on the street, but all the members I’ve come across were wearing masks and those long robes with hoods.",
                "zh": "虽然经常能见到他们的成员在路边发放周边和进行宣讲活动，但是我见过的所有成员都带着面具，穿着带有兜帽的长袍。",
                "ja": ""
            },
            "positionX": 7116.0,
            "positionY": 389.3333435058594,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "c2dede75-e955-4826-b87d-e4a6610303ce",
            "index": 46,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "useContentId": true,
            "contentId": "ch1_2061",
            "content": {
                "en": "Just so you know—Yuntai always goes into lockdown for the three days of the festival. Did your friend mention that to you?",
                "zh": "不过每次大会即将召开之际，芸台都会暂时封城直到三日后大会结束，这点你的朋友有告诉过你吗？",
                "ja": ""
            },
            "positionX": 5637.3330078125,
            "positionY": 1108.6666259765625,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "f9674299-a8bd-4a6a-a439-02a4ba67f2ba",
            "index": 47,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "useContentId": true,
            "contentId": "ch1_2064",
            "content": {
                "en": "There’s been some unrest during past festivals, and things have felt especially tense these past few years. Please be careful.",
                "zh": "往届乞巧大会期间，市内偶尔有些骚动，近几年局势似乎有些紧张，一定要注意安全哦。",
                "ja": ""
            },
            "positionX": 6709.3330078125,
            "positionY": 1116.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "0eec9ba1-b565-4e17-819d-949bd8480165",
            "index": 3,
            "characterId": "03fbd1fc-0e37-4fb2-abea-a8bb2982cffb",
            "useContentId": true,
            "contentId": "ch1_2029",
            "content": {
                "en": "(That’s exactly what he said in the dream… and that<color=red> puppet</color> in his hand—it reminds me of what he turned into.)",
                "zh": "（和之前梦里一模一样的对话，还有男孩手里的<color=red>木偶</color>......让我想起了他之前变成的那个样子。）",
                "ja": ""
            },
            "positionX": 226.6666717529297,
            "positionY": 364.6666564941406,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "9d8e9aa0-93c7-47e4-84ee-403380b91ade",
            "index": 6,
            "characterId": "0d2edd26-5554-47f2-b61f-99a5a0caf64b",
            "useContentId": true,
            "contentId": "ch1_2032",
            "content": {
                "en": "Someone gave it to me! I took it with me before we left for the trip!",
                "zh": "这是别人送给我的！出去玩之前我就带在身上了！",
                "ja": ""
            },
            "positionX": 1334.6666259765625,
            "positionY": 364.6666564941406,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "6077de95-3faf-40c1-8263-bfda71bacda2",
            "index": 7,
            "characterId": "318c68cb-5927-41a5-91bd-bf8aa614ee91",
            "useContentId": true,
            "contentId": "ch1_2033",
            "content": {
                "en": "Make sure you keep it safe this time. Don’t forget it at the hotel again.",
                "zh": "喜欢的话就要收好哦，不要像之前一样忘在酒店里了。",
                "ja": ""
            },
            "positionX": 1685.333251953125,
            "positionY": 364.6666564941406,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "c7a4d7ad-5d3c-41ef-af79-688a912ca11d",
            "index": 9,
            "characterId": "3d251560-306a-4584-8903-bebe74011bfc",
            "useContentId": true,
            "contentId": "ch1_2035",
            "content": {
                "en": "People in cloaks?",
                "zh": "穿着斗篷的人？",
                "ja": ""
            },
            "positionX": 2358.666748046875,
            "positionY": 360.6666564941406,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "44c2f83c-0f01-4892-8bef-a420936a4867",
            "index": 12,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_2037",
            "content": {
                "en": "About this \"Troupe Elysium\"—would you mind sharing what you know about them?",
                "zh": "关于这个“极乐戏团”，您方便告诉我一些关于他们的事吗？",
                "ja": ""
            },
            "positionX": 4541.3330078125,
            "positionY": 392.6666564941406,
            "choices": [],
            "eventCalls": [
                {
                    "targetObjectID": "",
                    "targetObjectName": "LevelManager2_1",
                    "targetSceneName": "",
                    "componentTypeName": "LevelManager2_1",
                    "methodName": "SetInfoPass1True",
                    "stringParameter": "",
                    "intParameter": 0,
                    "floatParameter": 0.0,
                    "boolParameter": false,
                    "parameterType": 0,
                    "triggerTiming": 0
                }
            ],
            "conditionalBranches": []
        },
        {
            "id": "5585f0d2-50b7-43bc-a8ee-07ff6063aa38",
            "index": 44,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "useContentId": true,
            "contentId": "ch1_2049a",
            "content": {
                "en": "There are all sorts of fun events and tons of traditional performances.",
                "zh": "大会上有各种各样有趣的活动，还会有很多本地特色的表演节目哦！",
                "ja": ""
            },
            "positionX": 5234.66650390625,
            "positionY": 744.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "888cb919-4346-47f1-a31f-dcdb03f55726",
            "index": 25,
            "characterId": "0d2edd26-5554-47f2-b61f-99a5a0caf64b",
            "useContentId": true,
            "contentId": "ch1_2050",
            "content": {
                "en": "It’s super fun! We’re getting back just in time—the opening ceremony is tomorrow!",
                "zh": "真的特别好玩！我们今天回去，正好能赶上明天大会正式开幕呢！",
                "ja": ""
            },
            "positionX": 5580.0,
            "positionY": 740.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "0a910f2e-4e62-4a54-8a11-c308a19aa67f",
            "index": 45,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "useContentId": true,
            "contentId": "ch1_2056",
            "content": {
                "en": "The festival still keeps the old “craft competitions,” which is probably how strange groups like Troupe Elysium get a chance to perform.",
                "zh": "大会也保留着斗巧的传统，这也是为什么像极乐戏团这种不知来路的奇怪团体也能参与大会进行表演。",
                "ja": ""
            },
            "positionX": 7786.66650390625,
            "positionY": 740.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        }
    ],
