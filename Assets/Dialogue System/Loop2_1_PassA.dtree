            "index": 37,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "content": {
                "en": "They didn’t? Then make sure you stay close to your friend, okay?",
                "zh": "",
                "ja": ""
            },
            "positionX": 6330.0,
            "positionY": 1112.6666259765625,
            "choices": [],
