            "positionX": 6444.0,
            "positionY": 392.6666564941406,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "5f76f23e-bf86-4296-bb56-543c1dcde82d",
            "index": 22,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "content": {
                "en": "But honestly, I don’t know that much about the troupe itself. \r",
                "zh": "",
                "ja": ""
