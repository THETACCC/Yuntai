            "index": 43,
            "characterId": "327ce24b-ea8e-4a5a-8219-89a8de213288",
            "content": {
                "en": "I’ve seen them around, handing out merch and giving talks on the street, but all the members I’ve come across were wearing masks and those long robes with hoods.\r",
                "zh": "",
                "ja": ""
            },
            "positionX": 7116.0,
            "positionY": 390.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
