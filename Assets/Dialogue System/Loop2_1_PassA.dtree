            "index": 38,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "content": {
                "en": "Thank you—I will.",
                "zh": "",
                "ja": ""
            },
            "positionX": 7103.3330078125,
            "positionY": 1120.6666259765625,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
