            "index": 1,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "content": {
                "en": "(They seem to be locals returning from a trip. They probably know a bit about what’s going on in Yuntai. I could use this chance to ask about the city.)",
                "zh": "",
                "ja": ""
            },
            "positionX": 4105.3330078125,
            "positionY": 358.6666564941406,
            "choices": [
                {
                    "text": {
                        "en": "About this \"Troupe Elysium\"...",
                        "zh": "",
                        "ja": ""
                    },
                    "conditions": [
                        {
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "infoPassA_1",
                            "comparison": 0,
                            "compareValue": "False"
                        }
                    ],
                    "conditionLogic": 0
                },
                {
                    "text": {
                        "en": "What is the festival?",
                        "zh": "",
                        "ja": ""
                    },
                    "conditions": [
                        {
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "infoPassA_2",
                            "comparison": 0,
                            "compareValue": "False"
                        }
                    ],
                    "conditionLogic": 0
                },
                {
                    "text": {
                        "en": "Thank you for telling me all this.",
                        "zh": "",
                        "ja": ""
                    },
                    "conditions": [
                        {
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "infoPassA_1",
                            "comparison": 0,
                            "compareValue": "True"
