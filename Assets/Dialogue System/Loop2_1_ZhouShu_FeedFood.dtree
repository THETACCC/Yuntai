                    "stringParameter": "",
                    "intParameter": 0,
                    "floatParameter": 0.0,
                    "boolParameter": false,
                    "parameterType": 0,
                    "triggerTiming": 0
                }
            ],
            "conditionalBranches": []
        },
        {
            "id": "798b6887-6819-4ffc-99a0-9b2ec59094be",
            "index": 23,
            "characterId": "91eae646-d3d2-46e9-9336-e09e16836545",
            "useContentId": true,
            "contentId": "ch1_2166",
            "content": {
                "en": "Yep! I’m a Taoist priest! Though honestly, it’s not like we’re required to wear this all the time. I just find the robes really comfortable, so I’ve kept wearing them.",
                "zh": "对啊，我是道士嘛！不过其实也没有要求说一直穿着的，但我觉得道袍穿着很舒服，所以就一直这样穿了。",
                "ja": ""
            },
            "positionX": 966.0,
            "positionY": 832.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "c1b83d63-53a4-43e9-aa62-da9bd802ab6b",
            "index": 24,
            "characterId": "3d251560-306a-4584-8903-bebe74011bfc",
            "useContentId": true,
            "contentId": "ch1_2167",
            "content": {
                "en": "There aren’t any Taoist priests in Wenqiu City, so I’m curious—what’s a Taoist’s daily life like?",
                "zh": "纹秋市里从来没有道士呢，我有些好奇，道士的生活是什么样的？",
                "ja": ""
            },
            "positionX": 1324.0,
            "positionY": 832.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "43586b78-071f-4ecc-8e97-722baae5c152",
            "index": 25,
            "characterId": "91eae646-d3d2-46e9-9336-e09e16836545",
            "useContentId": true,
            "contentId": "ch1_2168",
            "content": {
                "en": "Nothing too special, really. Our sect focuses more on talismans and spiritual techniques, but I’m terrible at all those complicated rituals and incantations.",
                "zh": "也没什么特别的吧，我们道派本来算是偏向术法符文专精的，但我实在学不来那些弯弯绕绕的仪式法咒。",
                "ja": ""
            },
            "positionX": 1696.0,
            "positionY": 832.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "dee7077a-549d-42c6-b245-7b7e723aeed3",
            "index": 26,
            "characterId": "91eae646-d3d2-46e9-9336-e09e16836545",
            "useContentId": true,
            "contentId": "ch1_2169",
            "content": {
                "en": "But I’m pretty fit physically, so I mostly just train my body and practice swordplay...",
                "zh": "不过我身体素质很好，所以基本就一直在炼体和练剑来着......",
                "ja": ""
            },
            "positionX": 2069.33349609375,
            "positionY": 836.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "a53e6095-ea68-4658-b7b6-c3508a733e25",
            "index": 27,
            "characterId": "3d251560-306a-4584-8903-bebe74011bfc",
            "useContentId": true,
            "contentId": "ch1_2170",
            "content": {
                "en": "I’m not sure I follow...",
                "zh": "有点听不明白......",
                "ja": ""
            },
            "positionX": 2424.0,
            "positionY": 836.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "a9513d7c-377e-4c88-9400-2de67acfbd41",
            "index": 28,
            "characterId": "481038d5-cf0b-4d90-b374-cf1fd0c406cd",
            "useContentId": true,
            "contentId": "ch1_2171",
            "content": {
                "en": "Ah, sorry! I’ve been rambling about all sorts of stuff! Honestly, most of the time I just handle random chores like ticketing and maintenance!",
                "zh": "啊不好意思！一直跟你唠叨乱七八糟的东西！其实大部分时间还是在做收门票一类的杂活啦！",
                "ja": ""
            },
            "positionX": 2766.0,
            "positionY": 836.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "5a32824c-0297-4390-ac28-511906155a9e",
            "index": 29,
            "characterId": "91eae646-d3d2-46e9-9336-e09e16836545",
            "useContentId": true,
            "contentId": "ch1_2172",
            "content": {
                "en": "Since I can’t remember much history, I’m no good as a tour guide.",
                "zh": "因为我记不住什么历史，所以没法给游客当导游。",
                "ja": ""
            },
            "positionX": 3114.0,
            "positionY": 836.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "8d0ea931-019f-417e-9b2b-4f16cbb23c7c",
            "index": 30,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_2174",
            "content": {
                "en": "(So this is what working at a temple is like...)",
                "zh": "（原来道观的工作是这样的吗。）",
                "ja": ""
            },
            "positionX": 3914.666748046875,
            "positionY": 848.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": [
                {
                    "priority": 1,
                    "conditions": [
                        {
                            "targetObjectID": "",
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "isZhouShu_Conv5",
                            "comparison": 0,
                            "compareValue": "True"
                        }
                    ],
                    "conditionLogic": 0
                },
                {
                    "priority": 0,
                    "conditions": [],
                    "conditionLogic": 0
                }
            ]
        },
        {
            "id": "b5665cce-ea46-47d4-a0bd-febea48f0f95",
            "index": 31,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_2175",
            "content": {
                "en": "(Come to think of it, in the dream, I never saw her turn into one of those monsters. Maybe she has the ability to fight them?)",
                "zh": "（说起来，之前在梦里，我没有看到她变成怪物的样子，或许她有能力对抗它们？）",
                "ja": ""
            },
            "positionX": 4352.0,
            "positionY": 828.0,
            "choices": [],
            "eventCalls": [
                {
                    "targetObjectID": "c53927c3-c77c-4e2f-8953-f20a86ed29da",
                    "targetObjectName": "LevelManager2_1",
                    "targetSceneName": "Level2-1",
                    "componentTypeName": "LevelManager2_1",
                    "methodName": "SetZhouShuConv7",
                    "stringParameter": "",
                    "intParameter": 0,
                    "floatParameter": 0.0,
                    "boolParameter": false,
                    "parameterType": 0,
                    "triggerTiming": 0
                }
            ],
            "conditionalBranches": []
        },
        {
            "id": "f7e31969-84a0-41be-973a-d14a6cf94660",
            "index": 32,
            "characterId": "3d251560-306a-4584-8903-bebe74011bfc",
            "useContentId": true,
            "contentId": "ch1_2176",
            "content": {
                "en": "You mentioned “body training” earlier—do you mean like physical conditioning?",
                "zh": "你之前提到过的炼体，是指锻炼身体一类吗？",
                "ja": ""
            },
            "positionX": 4718.0,
            "positionY": 828.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "af71218f-6877-46d5-9440-16e2bb99955f",
            "index": 33,
            "characterId": "91eae646-d3d2-46e9-9336-e09e16836545",
            "useContentId": true,
            "contentId": "ch1_2177",
            "content": {
                "en": "Pretty much! It also includes things like combat practice.",
                "zh": "差不多吧！也包括格斗术之类的练习就是了。",
                "ja": ""
            },
            "positionX": 5090.0,
            "positionY": 828.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "ebc7cc20-cbe6-4ca4-8067-f0fc05435dd9",
            "index": 34,
            "characterId": "d5be2dcf-87aa-4ebc-afce-674209069707",
            "useContentId": true,
            "contentId": "ch1_2178",
            "content": {
                "en": "(I should probably tell her what I saw in the dream, even if just as a precaution.)",
                "zh": "（我应该把之前梦里看到过的情景告诉她，哪怕只是以防万一。）",
                "ja": ""
            },
            "positionX": 5452.0,
            "positionY": 828.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "22245ef9-0066-47b8-a78b-8a27ba50fbbd",
            "index": 35,
            "characterId": "3d251560-306a-4584-8903-bebe74011bfc",
            "useContentId": true,
            "contentId": "ch1_2179",
            "content": {
                "en": "It might sound crazy, but earlier I think I saw some strange... people in the front cabin.",
                "zh": "虽然听起来很荒唐，但是我之前好像在前面的机舱看到了一些奇怪的......人。",
                "ja": ""
            },
            "positionX": 5833.3330078125,
            "positionY": 828.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "037cb877-e031-49ea-9f14-05b8abd0995d",
            "index": 36,
            "characterId": "91eae646-d3d2-46e9-9336-e09e16836545",
            "useContentId": true,
            "contentId": "ch1_2180",
            "content": {
                "en": "Huh? What kind of people?",
                "zh": "啊？是什么样子的？",
                "ja": ""
            },
            "positionX": 6206.0,
            "positionY": 828.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "d8c8586a-5bd4-4442-afb9-6156208bf8ac",
            "index": 37,
            "characterId": "3d251560-306a-4584-8903-bebe74011bfc",
            "useContentId": true,
            "contentId": "ch1_2181",
            "content": {
                "en": "They had really stiff joints and moved like puppets, with eerie smiles on their faces.",
                "zh": "是一些关节处很僵硬，会像人偶一样转动身体，脸上还挂着奇怪笑容的人。",
                "ja": ""
            },
            "positionX": 6577.3330078125,
            "positionY": 828.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "e83c5efb-a8bb-4199-902d-a98aa7193a19",
            "index": 38,
            "characterId": "481038d5-cf0b-4d90-b374-cf1fd0c406cd",
            "useContentId": true,
            "contentId": "ch1_2182",
            "content": {
                "en": "!!!",
                "zh": "！！！",
                "ja": ""
            },
            "positionX": 6944.0,
            "positionY": 828.6666870117188,
            "choices": [],
            "eventCalls": [
                {
                    "targetObjectID": "c53927c3-c77c-4e2f-8953-f20a86ed29da",
                    "targetObjectName": "LevelManager2_1",
                    "targetSceneName": "Level2-1",
                    "componentTypeName": "LevelManager2_1",
                    "methodName": "BlinkThenDim",
                    "stringParameter": "",
                    "intParameter": 0,
                    "floatParameter": 0.0,
                    "boolParameter": false,
                    "parameterType": 0,
                    "triggerTiming": 2
                }
            ],
            "conditionalBranches": []
        },
        {
            "id": "b9f32e02-c9a5-48a3-9ee2-4b3712842666",
            "index": 39,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_2150",
            "content": {
                "en": "No need to thank me. I’m just glad you’re okay. I’m Veris, from Wenqiu City.",
                "zh": "不用客气，你没事就好。我是何以真，来自纹秋市。",
                "ja": ""
            },
            "positionX": -234.66665649414063,
            "positionY": 258.6666564941406,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "6e562329-db5e-43fc-9c87-416675037ae6",
            "index": 40,
            "characterId": "91eae646-d3d2-46e9-9336-e09e16836545",
            "useContentId": true,
            "contentId": "ch1_2163",
            "content": {
                "en": "My Shifu was even considering raising the ticket price. I think bumping it to ten yuan would fix everything!",
                "zh": "师父之前也在考虑提高门票的事，我觉得涨到10块就能解决问题了！",
                "ja": ""
            },
            "positionX": 3674.0,
            "positionY": 245.33334350585938,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "1299aaf8-7bcf-428d-bcec-924a2891f77b",
            "index": 41,
            "characterId": "",
            "useContentId": true,
            "contentId": "ch1_2173",
            "content": {
                "en": "Even though I’m technically the senior disciple in the temple, I spend most of my days running errands and hauling things around...",
                "zh": "结果明明我算是观内弟子里辈分最大的，却基本上每天都在做杂活，还有当苦力搬东西......",
                "ja": ""
            },
            "positionX": 3484.0,
            "positionY": 846.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        }
