            "useContentId": true,
            "contentId": "ch1_2165",
            "content": {
                "en": "Your outfit is quite distinctive—does it have something to do with your profession?",
                "zh": "你的衣着很有特色呢，是跟职业有关吗？",
                "ja": ""
            },
            "positionX": 612.0,
            "positionY": 836.0,
