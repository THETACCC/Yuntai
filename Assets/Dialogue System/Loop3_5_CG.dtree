            "characterId": "",
            "useContentId": false,
            "contentId": "ch1_3227",
            "content": {
                "en": "12312123124asd",
                "zh": "伴随着摇滚曲震耳欲聋的响声，人偶原本飞速前冲的动作忽然磕绊了起来。",
                "ja": ""
            },
            "positionX": 15.333333015441895,
            "positionY": -3.333332061767578,
