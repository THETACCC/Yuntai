            "characterId": "",
            "useContentId": false,
            "contentId": "ch1_3230",
            "content": {
                "en": "asfadfadf",
                "zh": "待到白雾缓缓散去时，舱室中只剩下躺了满地的人偶，与立在最前方、英姿飒爽的周书。",
                "ja": ""
            },
            "positionX": 1262.0,
            "positionY": -3.333332061767578,
            "choices": [],
            "eventCalls": [],
