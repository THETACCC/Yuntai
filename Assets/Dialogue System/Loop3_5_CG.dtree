            "content": {
                "en": "asdsdqwdqwdqwd",
                "zh": "周书猛地将灭火器中对准前方冲来的人偶们，按下了压把。干冰微粒与水汽混合而成的白雾瞬间弥漫开来。",
                "ja": ""
            },
            "positionX": 428.6666564941406,
            "positionY": -3.333332061767578,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
