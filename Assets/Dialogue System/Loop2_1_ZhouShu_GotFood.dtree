        {
            "id": "292fd5cc-a547-4792-8477-3c9a441e5c02",
            "index": 1,
            "characterId": "91eae646-d3d2-46e9-9336-e09e16836545",
            "content": {
                "en": "Your name’s... Veris, right?",
                "zh": "你是叫...何以真，对吧？",
                "ja": ""
            },
            "positionX": 532.7999877929688,
            "positionY": 273.5999755859375,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "2e60782d-2913-44df-858f-4f0464de0e20",
            "index": 2,
            "characterId": "",
            "content": {
                "en": "Yes.",
                "zh": "是的。",
                "ja": ""
            },
            "positionX": 900.0,
            "positionY": 272.79998779296877,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "71988521-8fe6-4e4f-a2bf-a9bda448a2f4",
            "index": 3,
            "characterId": "",
            "content": {
                "en": "Alright, Veris. Listen to me carefully—go hide in the restroom at the back, now!",
                "zh": "好的，何以真，你听我说，现在立刻去到后面的卫生间躲起来！",
                "ja": ""
            },
            "positionX": 1255.199951171875,
            "positionY": 273.5999755859375,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "75c5c60d-cd19-4fce-a47a-ff0135c8c1ba",
            "index": 4,
            "characterId": "",
            "content": {
                "en": "What?",
                "zh": "什么？",
                "ja": ""
            },
            "positionX": 1602.39990234375,
            "positionY": 273.5999755859375,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "a7f28b13-5db5-40ac-ba2c-be9188cebf73",
            "index": 5,
            "characterId": "",
            "content": {
                "en": "I’m going up front to check the situation. If you hear anything strange, be very careful! I think something dangerous might have snuck onto this plane...",
                "zh": "我去前面查探一下情况，如果听到什么异常的响动，一定要小心！这架飞机上恐怕混进了很麻烦的家伙......",
                "ja": ""
            },
            "positionX": 1955.199951171875,
            "positionY": 273.5999755859375,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "e6843818-a104-406c-98da-8d13f52ff5af",
            "index": 6,
            "characterId": "",
            "content": {
                "en": "Is there anything I can do to help?",
                "zh": "有什么我能帮忙的地方吗？",
                "ja": ""
            },
            "positionX": 2292.800048828125,
            "positionY": 273.5999755859375,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "11f85d75-f0af-4ce6-a361-61e39ca2e0f8",
            "index": 7,
            "characterId": "",
            "content": {
                "en": "No—it’s way too dangerous for a civilian. Just go hide in the restroom, now!",
                "zh": "不行，对普通人来说实在太危险了，你赶紧去卫生间躲起来！",
                "ja": ""
            },
            "positionX": 2631.199951171875,
            "positionY": 273.5999755859375,
            "choices": [],
            "eventCalls": [],
