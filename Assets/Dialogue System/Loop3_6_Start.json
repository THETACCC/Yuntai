      "nextIndex": 1
    },
    {
      "index": 1,
      "name": {
        "en": "Veris",
        "zh": "何以真",
        "ja": ""
      },
      "avatarAddr": "DialogueImages/何以真_日常",
      "isPlayer": true,
      "content": {
        "en": "No need to thank me — we helped each other.",
        "zh": "不客气，我们是互帮互助。",
        "ja": ""
      },
      "nextIndex": 2
    },
    {
      "index": 2,
      "name": {
        "en": "Page",
        "zh": "周书",
        "ja": ""
      },
      "avatarAddr": "DialogueImages/周书_日常",
      "isPlayer": false,
      "content": {
        "en": "Ah, wait — after all this, I just realized—",
        "zh": "啊等等，经过了这么多事儿，我突然想起来——",
        "ja": ""
      },
      "nextIndex": 3
    },
    {
      "index": 3,
      "name": {
        "en": "Page",
        "zh": "周书",
        "ja": ""
      },
      "avatarAddr": "DialogueImages/周书_大笑",
      "isPlayer": false,
      "content": {
        "en": "I never got your name!",
        "zh": "我都还不知道你名字啊！",
        "ja": ""
      },
      "nextIndex": 4
    },
    {
      "index": 4,
