    },
    {
      "index": 14,
      "name": "",
      "avatarAddr": "",
      "content": "别客气，小姑娘你不是芸台本地人吧？\r\n",
      "nextIndex": 34,
      "choices": [],
      "eventCalls": []
    },
    {
      "index": 15,
      "name": "",
      "avatarAddr": "",
      "content": "（获得事件条目：芸台市内的可疑团体）",
      "nextIndex": 1,
      "choices": [],
