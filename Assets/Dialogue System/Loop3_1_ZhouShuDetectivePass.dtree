            "characterId": "91eae646-d3d2-46e9-9336-e09e16836545",
            "contentId": "Loop3_1_ZhouShu_node_10_dialogue",
            "content": {
                "en": "Relax, give me your hand.",
                "zh": "你放松一点，把手给我。",
                "ja": ""
            },
            "positionX": 1149.5999755859375,
            "positionY": 100.0,
            "choices": [],
            "eventCalls": [],
