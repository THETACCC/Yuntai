            "contentId": "Loop3_1_ZhouShu_node_8_dialogue",
            "content": {
                "en": "What! That’s the treasure my master specifically sent me to retrieve—there’s no way an outsider would know...",
                "zh": "什么！那可是师父特意派我去取的宝贝，外人不可能知道......",
                "ja": ""
            },
            "positionX": 477.6000061035156,
            "positionY": 100.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
