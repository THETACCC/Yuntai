            "contentId": "Loop3_1_ZhouShu_node_11_dialogue",
            "content": {
                "en": "That bronze mirror! So you really did leave before.",
                "zh": "那个铜镜！你之前果然是离开了。",
                "ja": ""
            },
            "positionX": 1494.39990234375,
            "positionY": 99.19999694824219,
            "choices": [],
            "eventCalls": [],
