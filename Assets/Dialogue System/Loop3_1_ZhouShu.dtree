            "index": 13,
            "characterId": "91eae646-d3d2-46e9-9336-e09e16836545",
            "useContentId": true,
            "contentId": "ch1_3027",
            "content": {
                "en": "Whatever you do, don’t let go. We should be within the city limits now. I hope this works.",
                "zh": "千万别松手，现在应该在市区范围了，但愿这能行。",
                "ja": ""
