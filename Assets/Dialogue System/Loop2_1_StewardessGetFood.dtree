            "positionX": -3282.400146484375,
            "positionY": 779.2000122070313,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "9ef15120-cecc-4c8c-a65c-19aee6d15b81",
            "index": 2,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "contentId": "Loop2_1_StewardessGetFood_node_2_dialogue",
            "content": {
                "en": "There’s a girl back there who looks really hungry. Would it be possible for me to take a meal to her?",
                "zh": "后面有一个女生似乎饿得很厉害，请问我可以先从这里拿一盒飞机餐给她吗？",
                "ja": ""
            },
            "positionX": -2921.60009765625,
            "positionY": 779.2000122070313,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "3fe03181-a422-4610-bd36-dc1429ee9849",
            "index": 3,
            "characterId": "8e0b2383-21fb-426e-bb74-fdbc40a2b884",
            "contentId": "Loop2_1_StewardessGetFood_node_3_dialogue",
            "content": {
                "en": "Oh my, I’m afraid not~ All in-flight meals are distributed according to schedule. I kindly ask you to be pa~tient~",
                "zh": "哎呀，那可不成~飞机上的所有餐饮都是统一发放的，还请您耐~心~等待吧。",
                "ja": ""
            },
            "positionX": -2556.0,
            "positionY": 779.2000122070313,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
