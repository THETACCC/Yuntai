        },
        {
            "id": "c0b44395-30f3-42e1-9ec9-e5feecf42109",
            "index": 12,
            "characterId": "",
            "content": "Hm? What is it now, miss? ",
            "positionX": -3283.199951171875,
            "positionY": 779.2000122070313,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "9ef15120-cecc-4c8c-a65c-19aee6d15b81",
            "index": 13,
            "characterId": "",
            "content": "There’s a girl back there who looks really hungry. Would it be possible for me to take a meal to her?",
            "positionX": -2922.400146484375,
            "positionY": 779.2000122070313,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "3fe03181-a422-4610-bd36-dc1429ee9849",
            "index": 14,
            "characterId": "",
            "content": "Oh my, I’m afraid not~ All in-flight meals are distributed according to schedule. I kindly ask you to be pa~tient~",
            "positionX": -2556.0,
            "positionY": 779.2000122070313,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "98f02357-4b8f-4d1d-bb9f-67c60b469bf4",
            "index": 15,
            "characterId": "",
            "content": "But—",
            "positionX": -2199.199951171875,
            "positionY": 779.2000122070313,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "03defe51-2a0f-4854-8488-c67f54909078",
            "index": 16,
            "characterId": "",
            "content": "Rules are rules, you know~",
            "positionX": -1832.800048828125,
            "positionY": 778.4000244140625,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "fae2df1c-9fdb-435f-8241-3a4f4df576b7",
            "index": 17,
            "characterId": "",
            "content": "(She really doesn’t want to talk to me.)",
            "positionX": -1462.4000244140625,
            "positionY": 786.4000244140625,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "f745db80-440f-483a-ae36-109106a78ea4",
            "index": 18,
            "characterId": "",
            "content": "(Maybe if I just keep bothering her, she’ll lose patience and hand one over.)",
            "positionX": -1081.60009765625,
            "positionY": 871.2000122070313,
            "choices": [
                {
                    "text": "Why standing here this whole time?",
                    "conditions": [
                        {
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "infoFour",
                            "comparison": 0,
                            "compareValue": "False"
                        }
                    ],
                    "conditionLogic": 0
                },
                {
                    "text": "You mentioned your supervisor earlier...",
                    "conditions": [
                        {
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "infoFour",
                            "comparison": 0,
                            "compareValue": "True"
                        },
                        {
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "isStewardess_Conv4",
                            "comparison": 0,
                            "compareValue": "False"
                        }
                    ],
                    "conditionLogic": 0
                },
                {
                    "text": "The strange groups in the city...",
                    "conditions": [
                        {
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "infoPassA_1",
                            "comparison": 0,
                            "compareValue": "True"
                        },
                        {
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "isStewardess_Conv1",
                            "comparison": 0,
                            "compareValue": "False"
                        }
                    ],
                    "conditionLogic": 0
                },
                {
                    "text": "The Qiqiao Festival is starting soon...",
                    "conditions": [
                        {
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "infoPassA_2",
                            "comparison": 0,
                            "compareValue": "True"
                        },
                        {
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "isStewardess_Conv2",
                            "comparison": 0,
                            "compareValue": "False"
                        }
                    ],
                    "conditionLogic": 0
                },
                {
                    "text": "About Yuntai going into lockdown...",
                    "conditions": [
                        {
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "infoPassA_3",
                            "comparison": 0,
                            "compareValue": "True"
                        },
                        {
                            "targetObjectName": "LevelManager2_1",
                            "componentTypeName": "LevelManager2_1",
                            "variableName": "isStewardess_Conv3",
                            "comparison": 0,
                            "compareValue": "False"
                        }
                    ],
                    "conditionLogic": 0
                },
                {
                    "text": "Sorry to bother you. I’ll be going now.",
                    "conditions": [],
                    "conditionLogic": 0
                },
                {
                    "text": "New Choice",
                    "conditions": [],
                    "conditionLogic": 0
                }
            ],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "6b07d1fe-e557-4dd4-b7ac-2b3617ce0df0",
            "index": 19,
            "characterId": "",
            "content": "You’ve been standing here for quite a while... may I ask—",
            "positionX": -682.3999633789063,
            "positionY": 451.20001220703127,
            "choices": [],
            "eventCalls": [
                {
                    "targetObjectName": "LevelManager2_1",
