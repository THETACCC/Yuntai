            "index": 31,
            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "contentId": "Loop2_1_StewardessGetFood_node_31_dialogue",
            "content": {
                "en": "(I think she just insulted me.)",
                "zh": "（好像被嫌弃了。）",
                "ja": ""
