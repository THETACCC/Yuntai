                    "parameterType": 0,
                    "triggerOnEnd": false
                }
            ],
            "conditionalBranches": []
        },
        {
            "id": "30546341-f63c-425f-a4c4-585eeb63f542",
            "index": 20,
            "characterId": "",
            "content": "......",
            "positionX": -352.79998779296877,
            "positionY": 451.20001220703127,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "1d5dd79c-602b-43b7-8278-f9b1b2f300ab",
            "index": 21,
            "characterId": "",
            "content": "(That’s terrifying!)",
            "positionX": -16.799999237060548,
            "positionY": 451.20001220703127,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "f938e56a-0167-4491-bf79-416839b3aeb6",
            "index": 22,
            "characterId": "",
            "content": "Oh, I wouldn’t know, miss. Our highly esteemed chief attendant suddenly ordered me to stand here on standby. Until she responds, I absolutely cannot leave my post.",
            "positionX": 331.20001220703127,
            "positionY": 451.20001220703127,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "2b1af18f-376c-4025-ad3e-5840e1e559ef",
            "index": 23,
            "characterId": "",
            "content": "(She’s speaking through clenched teeth...)",
            "positionX": 692.7999877929688,
            "positionY": 451.20001220703127,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "36b07a7d-c524-4877-8796-484297ef0a93",
            "index": 24,
            "characterId": "",
            "content": "(Better drop the subject.)",
            "positionX": 1060.0,
            "positionY": 451.20001220703127,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "30701851-5e95-4c92-8001-564c7badc365",
            "index": 32,
            "characterId": "",
            "content": "I heard there’ve been strange groups active in Yuntai recently.",
            "positionX": -682.3999633789063,
            "positionY": 1656.7999267578125,
            "choices": [],
            "eventCalls": [
                {
                    "targetObjectName": "LevelManager2_1",
                    "componentTypeName": "LevelManager2_1",
                    "methodName": "SetStewardessConv1",
                    "stringParameter": "",
                    "intParameter": 0,
                    "floatParameter": 0.0,
                    "boolParameter": false,
                    "parameterType": 0,
                    "triggerOnEnd": false
                }
            ],
            "conditionalBranches": []
        },
        {
            "id": "1e772e23-9319-4ffa-8038-f78854b50d7b",
            "index": 33,
            "characterId": "",
            "content": "I heard Yuntai holds a festival every two years—the Qiqiao Festival. Have you heard of it?",
            "positionX": -682.3999633789063,
            "positionY": 2151.199951171875,
            "choices": [],
            "eventCalls": [
                {
                    "targetObjectName": "LevelManager2_1",
                    "componentTypeName": "LevelManager2_1",
                    "methodName": "SetStewardessConv2",
                    "stringParameter": "",
                    "intParameter": 0,
                    "floatParameter": 0.0,
                    "boolParameter": false,
                    "parameterType": 0,
                    "triggerOnEnd": false
                }
            ],
            "conditionalBranches": []
        },
        {
            "id": "92ad4eec-9878-4d4e-8d1f-e077521a74eb",
            "index": 25,
            "characterId": "",
            "content": "The chief attendant you mentioned earlier—do you know where she is now?",
            "positionX": -682.3999633789063,
            "positionY": 1036.7999267578125,
            "choices": [],
            "eventCalls": [
                {
                    "targetObjectName": "LevelManager2_1",
                    "componentTypeName": "LevelManager2_1",
                    "methodName": "SetStewardessConv4",
                    "stringParameter": "",
                    "intParameter": 0,
                    "floatParameter": 0.0,
                    "boolParameter": false,
                    "parameterType": 0,
                    "triggerOnEnd": false
                }
            ],
            "conditionalBranches": []
        },
        {
            "id": "fb3c677e-2b4c-4ebc-ab21-4d9e50b54f93",
            "index": 26,
            "characterId": "",
            "content": "Probably up in the front cabin somewhere. I don’t know the details.",
            "positionX": -352.79998779296877,
            "positionY": 1037.5999755859375,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "d4bc759d-d58c-41e2-9a6f-4d4ebd4eed4b",
            "index": 27,
            "characterId": "",
            "content": "Are you two close?",
            "positionX": -16.799999237060548,
            "positionY": 1037.5999755859375,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "484e884c-c707-4e36-bc53-db16868f157b",
            "index": 28,
            "characterId": "",
            "content": "Do I look like someone who’s close with her?",
            "positionX": 331.20001220703127,
            "positionY": 1036.7999267578125,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "0f840cd6-eff3-46a6-b39a-6dcc21987adf",
            "index": 29,
            "characterId": "",
            "content": "(Yeah… this conversation’s going nowhere.)",
            "positionX": 692.7999877929688,
            "positionY": 1038.39990234375,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "88eba7eb-7208-4753-94a6-17ac2da061a3",
            "index": 38,
            "characterId": "",
            "content": "(She does look kind of suspicious...)",
            "positionX": 692.7999877929688,
            "positionY": 1656.7999267578125,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "d088ebd4-f369-4e71-8a9e-51d3001aaa44",
            "index": 39,
            "characterId": "",
            "content": "But as long as they don’t cause trouble, it’s not our place to intervene. We’re service crew, not judges.",
            "positionX": 1048.7999267578125,
            "positionY": 1656.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "870607a5-5bd4-4c18-8cba-d96511c2431a",
            "index": 40,
            "characterId": "",
            "content": "(So she’s actually quite professional…)",
            "positionX": 1404.7999267578125,
            "positionY": 1656.7999267578125,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "215f9d44-9703-43c9-834a-0a79f96750ae",
            "index": 36,
            "characterId": "",
            "content": "Have you seen anyone suspicious onboard lately?",
            "positionX": -16.799999237060548,
            "positionY": 1656.7999267578125,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "64d61528-01cb-450a-8b3b-64861c066aae",
            "index": 35,
            "characterId": "",
            "content": "Miss, I’m not from Yuntai. I don’t really know anything about that. I just work on the plane.",
            "positionX": -352.79998779296877,
            "positionY": 1656.7999267578125,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "e779a903-abf5-4623-907a-962c97ea6f06",
            "index": 37,
            "characterId": "",
            "content": "Of course. That weird girl in the back wearing a Taoist robe looks pretty suspicious, doesn’t she?",
            "positionX": 326.4000244140625,
            "positionY": 1656.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "f5c3516d-43af-4f7b-b254-40035d51e641",
            "index": 41,
            "characterId": "",
            "content": "Hmm… I think it’s pretty well-known. We usually get passengers coming for it around this time of year.",
            "positionX": -331.1999816894531,
            "positionY": 2151.199951171875,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "3ebfba84-127f-4b1f-92bc-c80dd614b8c1",
            "index": 42,
            "characterId": "",
            "content": "Are you planning to check it out after landing?",
            "positionX": 12.0,
            "positionY": 2151.199951171875,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "0c6fcd1e-0560-4c87-a879-f6717f8b8863",
            "index": 43,
            "characterId": "",
            "content": "That’s a personal matter, miss. But I don’t like crowds—especially the noisy kind, like you.",
            "positionX": 378.4000244140625,
            "positionY": 2151.199951171875,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "7da62a19-9955-4d8b-92fd-72db1941755f",
            "index": 44,
            "characterId": "",
            "content": "(I think she just insulted me.)",
            "positionX": 734.4000244140625,
            "positionY": 2150.39990234375,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "2d3e4902-7e11-416a-b713-85ebf3a758ff",
            "index": 34,
            "characterId": "",
            "content": "Isn’t Yuntai going into lockdown soon? Does that mean you’ll be stuck here until it ends?",
            "positionX": -682.3999633789063,
            "positionY": 2648.0,
            "choices": [],
            "eventCalls": [
                {
                    "targetObjectName": "LevelManager2_1",
                    "componentTypeName": "LevelManager2_1",
                    "methodName": "SetStewardessConv3",
                    "stringParameter": "",
                    "intParameter": 0,
                    "floatParameter": 0.0,
                    "boolParameter": false,
                    "parameterType": 0,
                    "triggerOnEnd": false
                }
            ],
            "conditionalBranches": []
        },
        {
            "id": "2cf4be47-c2b7-4589-a76b-a4b88b096c51",
            "index": 45,
            "characterId": "",
            "content": "Ugh, same thing every year. Last year, my assigned crew flew out before the lockdown. This time, I just happened to be on the unlucky shift. Once we land, the whole crew will probably be stuck waiting it out.",
            "positionX": -331.1999816894531,
            "positionY": 2648.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
            "id": "526a3c5b-170e-4783-982d-c441f0a332fa",
            "index": 46,
            "characterId": "",
            "content": "(She says that, but her smile looks more genuine than ever. She must be happy to get some time off.)",
            "positionX": 12.0,
            "positionY": 2648.0,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        }
    ],
