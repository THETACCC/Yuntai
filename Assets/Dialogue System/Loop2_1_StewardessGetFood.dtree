            "characterId": "fe717acf-a852-4395-beb4-8cbc7dc92d14",
            "contentId": "Loop2_1_StewardessGetFood_node_1_dialogue",
            "content": {
                "en": "Hm? What is it now, miss?",
                "zh": "嗯？又有什么事吗女士？（微笑）",
                "ja": ""
