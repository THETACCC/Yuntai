            "contentId": "Loop2_1_StewardessGetFood_node_27_dialogue",
            "content": {
                "en": "(So she’s actually quite professional…)",
                "zh": "（乘务员小姐原来是个很有职业精神的人啊。）",
                "ja": ""
            },
            "positionX": 1405.5999755859375,
            "positionY": 1656.800048828125,
            "choices": [],
