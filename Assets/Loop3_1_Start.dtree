            "index": 4,
            "characterId": "d5be2dcf-87aa-4ebc-afce-674209069707",
            "useContentId": true,
            "contentId": "ch1_3005",
            "content": {
                "en": "Calm down. There must be a way off this plane.",
                "zh": "冷静下来，一定有办法能离开这趟飞机。",
                "ja": ""
            },
            "positionX": 2120.0,
            "positionY": 728.0,
            "choices": [],
            "eventCalls": [],
