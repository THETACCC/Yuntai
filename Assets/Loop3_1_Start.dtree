            "useContentId": true,
            "contentId": "ch1_3006",
            "content": {
                "en": "Before Page disappeared, that mirror in her hand gave off a white light.",
                "zh": "周书消失之前，她手里的那面镜子发出了白光。",
                "ja": ""
            },
            "positionX": 2496.666748046875,
            "positionY": 726.6666870117188,
            "choices": [],
            "eventCalls": [],
            "conditionalBranches": []
        },
        {
