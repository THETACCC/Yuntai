            "characterId": "443ed651-99c1-456e-8295-e76ba2741aa7",
            "useContentId": true,
            "contentId": "ch1_3008",
            "content": {
                "en": "Either way, Page is my only hope now. I have to hurry!",
                "zh": "无论如何，现在我只能指望周书了。得抓紧时间！",
                "ja": ""
            },
